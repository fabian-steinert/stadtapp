<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  <style>
    * { box-sizing: border-box; }
    html, body { margin: 0; height: 100%; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #172033; }
    body { display: flex; flex-direction: column; }
    .navbar {
      height: 64px; display: flex; align-items: center; gap: 12px; padding: 0 20px;
      background: #fff; border-bottom: 1px solid #e5e7eb; box-shadow: 0 1px 6px rgba(0,0,0,.06); z-index: 1000;
    }
    .logo {
      width: 38px; height: 38px; display: grid; place-items: center; flex: 0 0 38px;
      border-radius: 11px; background: #2563eb; color: #fff; font-size: 21px; font-weight: 700;
    }
    .city-name { font-size: 19px; font-weight: 650; }
    .version { font-size: 12px; color: #6b7280; margin-left: 8px; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
    .nav-spacer { flex: 1; }
    .new-poi-button {
      border: 0; border-radius: 9px; padding: 10px 15px; background: #2563eb; color: white;
      font: inherit; font-weight: 600; cursor: pointer;
    }
    .new-poi-button:hover { background: #1d4ed8; }
    .new-poi-button.active { background: #16a34a; }
    #map { flex: 1; min-height: 0; width: 100%; }
    .poi-popup { min-width: 230px; }
    .poi-popup h3 { margin: 0 0 7px; font-size: 17px; }
    .poi-popup p { margin: 5px 0; line-height: 1.4; }
    .poi-popup .label { font-weight: 650; }
    .edit-button {
      width: 100%; margin-top: 10px; padding: 8px 10px; border: 1px solid #d1d5db;
      border-radius: 7px; background: #fff; cursor: pointer; font: inherit;
    }
    .edit-button:hover { background: #f3f4f6; }
    .form-popup { min-width: 260px; }
    .form-popup label { display: block; margin: 8px 0 4px; font-weight: 600; }
    .form-popup input, .form-popup textarea {
      width: 100%; padding: 8px; border: 1px solid #d1d5db; border-radius: 6px; font: inherit;
    }
    .form-popup textarea { min-height: 70px; resize: vertical; }
    .form-actions { display: flex; gap: 8px; margin-top: 10px; }
    .form-actions button {
      flex: 1; padding: 8px; border: 0; border-radius: 7px; cursor: pointer; font: inherit; font-weight: 600;
    }
    .save-button { background: #2563eb; color: white; }
    .cancel-button { background: #e5e7eb; color: #172033; }
    .map-hint {
      position: absolute; top: 78px; left: 50%; transform: translateX(-50%);
      z-index: 900; padding: 8px 12px; border-radius: 8px; background: white;
      box-shadow: 0 2px 10px rgba(0,0,0,.15); display: none;
    }
  </style>
</head>
<body>
  <nav class="navbar" aria-label="Hauptnavigation">
    <div class="logo" aria-hidden="true">⌖</div>
    <div class="city-name">Karlsruhe</div>
    <div class="version" title="Build-Version">build <%= buildVersion.slice(0, 7) %></div>
    <div class="nav-spacer"></div>
    <button id="newPoiButton" class="new-poi-button" type="button">Neuer POI</button>
  </nav>

  <div id="map-hint" class="map-hint">Klicke auf die Karte, um den neuen POI anzulegen.</div>
  <main id="map" aria-label="Karte von Karlsruhe"></main>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    const karlsruhe = [49.0069, 8.4037];
    const map = L.map("map").setView(karlsruhe, 13);
    const poiMarkers = new Map();
    let createMode = false;

    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);

    const newPoiButton = document.getElementById("newPoiButton");
    const mapHint = document.getElementById("map-hint");

    newPoiButton.addEventListener("click", () => {
      createMode = !createMode;
      newPoiButton.classList.toggle("active", createMode);
      newPoiButton.textContent = createMode ? "Abbrechen" : "Neuer POI";
      mapHint.style.display = createMode ? "block" : "none";
      map.getContainer().style.cursor = createMode ? "crosshair" : "";
    });

    map.on("click", async (event) => {
      if (!createMode) return;

      createMode = false;
      newPoiButton.classList.remove("active");
      newPoiButton.textContent = "Neuer POI";
      mapHint.style.display = "none";
      map.getContainer().style.cursor = "";

      const address = await reverseGeocode(event.latlng.lat, event.latlng.lng);
      openCreateForm(event.latlng, address);
    });

    async function reverseGeocode(latitude, longitude) {
      try {
        const response = await fetch(
          `https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${latitude}&lon=${longitude}&zoom=18&addressdetails=1`
        );

        if (!response.ok) throw new Error("Geocoding fehlgeschlagen");

        const data = await response.json();
        return data.display_name || "";
      } catch (error) {
        console.error(error);
        return "";
      }
    }

    function escapeHtml(value) {
      return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function openCreateForm(latlng, address) {
      const form = document.createElement("div");
      form.className = "form-popup";
      form.innerHTML = `
        <strong>Neuer POI</strong>
        <label for="poi-title">Titel</label>
        <input id="poi-title" type="text" required autofocus>
        <label for="poi-description">Beschreibung</label>
        <textarea id="poi-description"></textarea>
        <label for="poi-address">Adresse</label>
        <input id="poi-address" type="text" value="${escapeHtml(address)}" required>
        <label for="poi-author">Autor:in</label>
        <input id="poi-author" type="text" required>
        <div class="form-actions">
          <button class="cancel-button" type="button">Abbrechen</button>
          <button class="save-button" type="button">Speichern</button>
        </div>
      `;

      const popup = L.popup().setLatLng(latlng).setContent(form).openOn(map);

      form.querySelector(".cancel-button").addEventListener("click", () => map.closePopup());
      form.querySelector(".save-button").addEventListener("click", async () => {
        const title = form.querySelector("#poi-title").value.trim();
        const description = form.querySelector("#poi-description").value.trim();
        const addressValue = form.querySelector("#poi-address").value.trim();
        const author = form.querySelector("#poi-author").value.trim();

        if (!title || !addressValue || !author) {
          alert("Bitte Titel, Adresse und Autor:in ausfüllen.");
          return;
        }

        const response = await fetch("/api/pois", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            title,
            description,
            address: addressValue,
            author,
            latitude: latlng.lat,
            longitude: latlng.lng
          })
        });

        if (!response.ok) {
          alert("Der POI konnte nicht gespeichert werden.");
          return;
        }

        const poi = await response.json();
        addPoiMarker(poi);
        map.closePopup();
      });

      setTimeout(() => form.querySelector("#poi-title").focus(), 0);
    }

    function poiPopup(poi) {
      const wrapper = document.createElement("div");
      wrapper.className = "poi-popup";
      wrapper.innerHTML = `
        <h3>${escapeHtml(poi.title)}</h3>
        ${poi.description ? `<p>${escapeHtml(poi.description)}</p>` : ""}
        <p><span class="label">Adresse:</span> ${escapeHtml(poi.address)}</p>
        <p><span class="label">Autor:in:</span> ${escapeHtml(poi.author)}</p>
        <button class="edit-button" type="button">Bearbeiten</button>
      `;

      wrapper.querySelector(".edit-button").addEventListener("click", () => openEditForm(poi));
      return wrapper;
    }

    function addPoiMarker(poi) {
      const marker = L.marker([poi.latitude, poi.longitude]).addTo(map);
      marker.bindPopup(poiPopup(poi));
      poiMarkers.set(poi.id, marker);
    }

    function openEditForm(poi) {
      const form = document.createElement("div");
      form.className = "form-popup";
      form.innerHTML = `
        <strong>POI bearbeiten</strong>
        <label for="poi-title">Titel</label>
        <input id="poi-title" type="text" value="${escapeHtml(poi.title)}" required>
        <label for="poi-description">Beschreibung</label>
        <textarea id="poi-description">${escapeHtml(poi.description)}</textarea>
        <label for="poi-address">Adresse</label>
        <input id="poi-address" type="text" value="${escapeHtml(poi.address)}" required>
        <label for="poi-author">Autor:in</label>
        <input id="poi-author" type="text" value="${escapeHtml(poi.author)}" required>
        <div class="form-actions">
          <button class="cancel-button" type="button">Abbrechen</button>
          <button class="save-button" type="button">Speichern</button>
        </div>
      `;

      const marker = poiMarkers.get(poi.id);
      marker.bindPopup(form).openPopup();

      form.querySelector(".cancel-button").addEventListener("click", () => {
        marker.bindPopup(poiPopup(poi)).openPopup();
      });

      form.querySelector(".save-button").addEventListener("click", async () => {
        const updatedPoi = {
          ...poi,
          title: form.querySelector("#poi-title").value.trim(),
          description: form.querySelector("#poi-description").value.trim(),
          address: form.querySelector("#poi-address").value.trim(),
          author: form.querySelector("#poi-author").value.trim()
        };

        if (!updatedPoi.title || !updatedPoi.address || !updatedPoi.author) {
          alert("Bitte Titel, Adresse und Autor:in ausfüllen.");
          return;
        }

        const response = await fetch(`/api/pois/${encodeURIComponent(poi.id)}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(updatedPoi)
        });

        if (!response.ok) {
          alert("Der POI konnte nicht gespeichert werden.");
          return;
        }

        const savedPoi = await response.json();
        marker.bindPopup(poiPopup(savedPoi)).openPopup();
      });
    }

    async function loadPois() {
      const response = await fetch("/api/pois");
      if (!response.ok) return;

      const pois = await response.json();
      pois.forEach(addPoiMarker);
    }

    loadPois();
  </script>
</body>
</html>
